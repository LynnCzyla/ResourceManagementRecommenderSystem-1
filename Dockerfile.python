# ============================================================
# RMRS Python service (OCR + spaCy NLP + ML) - for Railway
# Build context = repo root.
# ============================================================
FROM python:3.10-slim

# tesseract: pytesseract | libgl1/libglib2.0-0: opencv | poppler-utils: pdf2image
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/python

COPY python/requirements.clean.txt ./requirements.clean.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.clean.txt gunicorn \
    && pip install --no-cache-dir https://github.com/explosion/spacy-models/releases/download/en_core_web_md-3.7.1/en_core_web_md-3.7.1-py3-none-any.whl

COPY python/ /app/python/

ENV PYTHONUNBUFFERED=1
# Railway injects PORT. 1 worker (spaCy + OCR are RAM-heavy), 2 threads so /health
# answers while a document is processing. Timeout 900s: OCR of big scans is slow.
CMD gunicorn --bind 0.0.0.0:${PORT:-5001} --workers 1 --threads 2 --timeout 1500 scripts.daemon:app