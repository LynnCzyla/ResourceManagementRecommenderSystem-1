# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=documents

# --- Python OCR/NLP service ---
# Local dev: http://127.0.0.1:5001 | Production: your Railway URL
PYTHON_DAEMON_URL=http://127.0.0.1:5001
# Must equal PYTHON_API_KEY on the Python service. Leave empty for local dev.
PYTHON_API_KEY=

# --- URLs ---
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Production: comma-separated Vercel URL(s). Empty = allow all (dev only).
CORS_ORIGINS=

# --- Email (Brevo HTTP API is the one that works on Render free tier) ---
BREVO_API_KEY=
SMTP_FROM=
# Only needed if you still use SMTP locally:
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
